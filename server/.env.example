# Use a managed PostgreSQL connection string. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=battle-universe-accounts
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=

# Admin bootstrap: configure privately in Render; never commit actual values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_TOKEN_MINUTES=120
